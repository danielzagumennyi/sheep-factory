{
  "name": "ovechya-fabrika",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.2",
  "scripts": {
    "dev": "pnpm --filter @ws/game dev",
    "build": "pnpm --filter @ws/game build",
    "preview": "pnpm --filter @ws/game preview",
    "typecheck": "tsc --noEmit -p packages/input && tsc --noEmit -p packages/outline && tsc --noEmit -p packages/game && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "vitest run packages/game/src/game/bot.test.ts --reporter=verbose"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "5",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
